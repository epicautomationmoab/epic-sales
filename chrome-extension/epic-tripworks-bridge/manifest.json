{
  "manifest_version": 3,
  "name": "Epic TripWorks Availability Bridge",
  "version": "0.1.0",
  "description": "Lets EpicC360 request live TripWorks availability from a signed-in TripWorks tab.",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://epic4x4.tripworks.com/*",
    "https://epic4x4sales.com/*",
    "https://www.epic4x4sales.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://epic4x4sales.com/*", "https://www.epic4x4sales.com/*"],
      "js": ["epic-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://epic4x4.tripworks.com/*"],
      "js": ["tripworks-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://epic4x4.tripworks.com/*"],
      "js": ["tripworks-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
